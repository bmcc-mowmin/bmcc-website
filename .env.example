# ─────────────────────────────────────────────────────────────────────────────
# BMCC website — environment settings
# Copy to .env (`npm run setup` does this and generates secrets for you).
# Values shown are safe LOCAL defaults. Secrets are blank on purpose.
# Every variable is validated at startup by src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# local | staging | production. Controls seed guard, dev login, mock payments.
APP_ENV=local
# Public base URL (no trailing slash). Used in emails, .ics files, redirects.
APP_URL=http://localhost:3000
APP_PORT=3000
LOG_LEVEL=info
# Production with more than one app instance: a shared key so server actions work on every
# instance (base64, 32 bytes: `openssl rand -base64 32`). Leave blank locally.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Database (Postgres in Docker locally) ────────────────────────────────────
POSTGRES_USER=bmcc
POSTGRES_PASSWORD=bmcc
POSTGRES_DB=bmcc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bmcc:bmcc@localhost:5432/bmcc

# ── Auth ─────────────────────────────────────────────────────────────────────
# dev   = built-in email/password login for the seeded test accounts (never in production)
# clerk = Clerk (set the three CLERK_* keys below)
AUTH_PROVIDER=dev
# Signs the dev-login session cookie. `npm run setup` fills this in. 32+ chars.
SESSION_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Seed (local only — the seed script refuses to run when APP_ENV=production) ─
SEED_ADMIN_EMAIL=admin@bmcc.local
SEED_ADMIN_PASSWORD=
SEED_MEMBER_EMAIL=member@bmcc.local
SEED_MEMBER_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
# smtp (Mailpit locally, or any SMTP relay) | resend | postmark
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# API key when MAIL_TRANSPORT is resend or postmark
MAIL_PROVIDER_API_KEY=
MAIL_FROM="BMCC <no-reply@brmcc.org>"
MAIL_REPLY_TO=info@brmcc.org
# Where contact-form messages are delivered
CONTACT_INBOX=info@brmcc.org
# Mailpit web inbox (local only; used by tests)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025

# ── Payments ─────────────────────────────────────────────────────────────────
# mock   = simulated checkout, no real money (local only)
# stripe = Stripe Checkout + Billing (see GO_LIVE.md)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBERSHIP_MONTHLY=
STRIPE_PRICE_MEMBERSHIP_YEARLY=
# one-time | monthly — default selection on the Donate page
DEFAULT_DONATION_FREQUENCY=monthly

# ── Organization (printed on tax receipts — confirm before go-live) ──────────
ORG_LEGAL_NAME="Brentwood Muslim Community Center"
ORG_EIN=
ORG_ADDRESS="7701 Lone Tree Way, Brentwood, CA 94513"
ORG_PHONE="925-298-BMCC (2622)"
# Dialable form of ORG_PHONE for tel: links
ORG_PHONE_TEL=+19252982622
ORG_EMAIL=info@brmcc.org

# ── Masjid location (seeds the prayer-time settings) ─────────────────────────
MASJID_TIMEZONE=America/Los_Angeles
MASJID_LAT=37.93
MASJID_LNG=-121.70

# ── File storage ─────────────────────────────────────────────────────────────
# local = files in UPLOAD_DIR | s3 = any S3-compatible bucket
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Spam protection (applies to every public form) ───────────────────────────
RATE_LIMIT_WINDOW_SEC=600
RATE_LIMIT_MAX=5
# Optional Cloudflare Turnstile. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Maps ─────────────────────────────────────────────────────────────────────
# Optional. Blank = keyless Google Maps embed.
GOOGLE_MAPS_EMBED_API_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# Show the re-subscribe bar on every page instead of only Home
SHOW_RESUB_BAR_SITEWIDE=false

# ── Tests ────────────────────────────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3000
